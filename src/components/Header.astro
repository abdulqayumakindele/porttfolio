---
const navLinks = [
  ['Home', '/'],
  ['About', '/about'],
  ['Qualifications', '/qualifications'],
  ['Projects', '/projects'],
  ['Writing', '/writing'],
  ['Quotes & Thoughts', '/quotes'],
  ['Contact', '/contact'],
];
---
<header class="site-header">
  <a class="brand" href="/">ABDUL QAYUM AKINDELE</a>
  <button class="menu" aria-label="Open menu" aria-expanded="false">☰</button>
  <nav aria-label="Main navigation">
    {navLinks.map(([label, href]) => (
      <a href={href}>{label}</a>
    ))}
  </nav>
</header>

<nav class="mobile-nav" aria-label="Mobile navigation">
  <button class="mobile-close" aria-label="Close menu">✕</button>
  {navLinks.map(([label, href]) => (
    <a href={href}>{label}</a>
  ))}
</nav>
