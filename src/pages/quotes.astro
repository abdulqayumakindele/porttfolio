---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { quotes, quote } from '../data/content.js';

const categories = ['All', 'Life & Growth', 'Technology & Cybersecurity', 'Learning', 'Books & Ideas', 'Personal Thoughts'];
---
<Layout title="Quotes & Thoughts | Abdul Qayum Akindele">
<Header/>
<main id="main-content">

  <div class="wrap page-header">
    <span class="tag" aria-hidden="true">Reflections</span>
    <h1 class="page-title" style="margin-top:12px;">Quotes &amp; Thoughts</h1>
    <p class="page-subtitle">Short reflections, observations, lessons from books, and thoughts from experiences — on technology, learning, life, and discipline.</p>
  </div>

  <!-- FEATURED QUOTE -->
  <section class="section" aria-labelledby="featured-quote-heading">
    <div class="wrap">
      <span class="tag" aria-hidden="true">Featured Thought</span>
      <figure style="margin:20px 0 0;">
        <blockquote class="quote-block large">
          "{quote}"
        </blockquote>
        <figcaption style="margin-top:18px;color:#656d7c;font-size:.88rem;">— Abdul Qayum Akindele</figcaption>
      </figure>
    </div>
  </section>

  <!-- COLLECTION -->
  <section class="section" aria-labelledby="collection-heading">
    <div class="wrap">
      <h2 class="section-title" id="collection-heading" style="margin-bottom:24px;">All Quotes &amp; Thoughts</h2>

      <!-- FILTER BAR -->
      <div class="filter-bar" role="group" aria-label="Filter quotes by category">
        {categories.map((cat, i) => (
          <button
            class={`filter-btn${i === 0 ? ' active' : ''}`}
            data-cat={cat}
            aria-pressed={i === 0 ? 'true' : 'false'}
          >
            {cat}
          </button>
        ))}
      </div>

      <!-- QUOTES LIST -->
      <div id="quotes-grid" style="display:flex;flex-direction:column;gap:20px;">
        {quotes.map(q => (
          <article
            class="card"
            data-category={q.category}
            style="border-left:3px solid rgba(38,127,255,.5);border-radius:0 14px 14px 0;padding:28px;"
          >
            <!-- Header row -->
            <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:16px;margin-bottom:16px;flex-wrap:wrap;">
              <span class="tag">{q.category}</span>
              <span style="font-size:.78rem;color:#656d7c;text-transform:uppercase;letter-spacing:.04em;">{q.type}</span>
            </div>

            <!-- Quote text — handle multi-paragraph -->
            {q.text.split('\n\n').map(para => (
              <p style="font-size:clamp(1rem,1.8vw,1.15rem);color:#e8eaf0;line-height:1.7;margin-bottom:10px;font-style:italic;">
                {q.type === 'Book Quote' ? `"${para}"` : para}
              </p>
            ))}

            <!-- Attribution -->
            {q.type === 'Book Quote' ? (
              <div style="margin-top:16px;padding-top:14px;border-top:1px solid rgba(255,255,255,.07);">
                <p style="font-size:.88rem;color:#65a8ff;font-weight:600;">{q.book}</p>
                <p style="font-size:.82rem;color:#9ca3b1;margin-top:3px;">
                  — {q.attribution}
                  {q.chapter && <span> · {q.chapter}</span>}
                  {q.page && <span> · p. {q.page}</span>}
                </p>
              </div>
            ) : q.type === 'Personal Writing' ? (
              <div style="margin-top:16px;padding-top:14px;border-top:1px solid rgba(255,255,255,.07);">
                <p style="font-size:.82rem;color:#656d7c;">— {q.attribution}</p>
                {q.source && (
                  <p style="font-size:.8rem;color:#4a5263;margin-top:6px;font-style:italic;">{q.source}</p>
                )}
              </div>
            ) : (
              <p style="margin-top:14px;font-size:.82rem;color:#656d7c;">— {q.attribution}</p>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CATEGORIES LEGEND -->
  <section class="section" aria-labelledby="categories-heading">
    <div class="wrap">
      <span class="tag" aria-hidden="true">Categories</span>
      <h2 class="section-title" id="categories-heading" style="margin-top:12px;">What You'll Find Here</h2>
      <ul class="grid-3" role="list" style="margin-top:24px;padding:0;list-style:none;">
        {[
          ['🌱', 'Life & Growth',               'Reflections on discipline, growth, and living with intention.'],
          ['🔐', 'Technology & Cybersecurity',   'Observations and thoughts from my learning journey in tech.'],
          ['📖', 'Learning',                     'Lessons about how to learn better, stay consistent, and grow.'],
          ['📚', 'Books & Ideas',                'Exact quotations from books that have shaped how I think, with full attribution.'],
          ['💭', 'Personal Thoughts',            'Honest thoughts and reflections from my own experiences and writing.'],
        ].map(([icon, title, desc]) => (
          <li>
            <div class="card" style="text-align:center;">
              <div style="font-size:1.6rem;margin-bottom:8px;" aria-hidden="true">{icon}</div>
              <h3 style="font-size:.95rem;">{title}</h3>
              <p class="muted" style="font-size:.85rem;margin-top:6px;">{desc}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

</main>
<Footer/>
</Layout>

<script>
  const filterBtns = document.querySelectorAll('.filter-btn[data-cat]');
  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => {
        b.classList.remove('active');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-pressed', 'true');
      const cat = btn.dataset.cat;
      document.querySelectorAll('#quotes-grid [data-category]').forEach(card => {
        card.style.display = (cat === 'All' || card.dataset.category === cat) ? '' : 'none';
      });
    });
  });
</script>
