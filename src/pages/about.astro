---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { about } from '../data/content.js';
---
<Layout title="About | Abdul Qayum Akindele">
<Header/>
<main id="main-content">

  <div class="wrap page-header">
    <span class="tag" aria-hidden="true">Personal Portfolio</span>
    <h1 class="page-title" style="margin-top:12px;">About Me</h1>
    <p class="page-subtitle">Curiosity → Learning → Experimenting → Building → Sharing → Becoming an Ethical Hacker</p>
  </div>

  <!-- TWO-COLUMN OPENING -->
  <section class="section" aria-labelledby="intro-heading">
    <div class="wrap split">
      <div>
        <span class="tag" aria-hidden="true">Introduction</span>
        <h2 class="section-title" id="intro-heading" style="margin-top:12px;">Abdul Qayum Akindele</h2>
        {about.intro.map(para => (
          <p style="color:#c8ccd5;margin:16px 0;line-height:1.75;font-size:1.02rem;">{para}</p>
        ))}

        <div style="margin-bottom:28px;">
          <p class="muted" style="font-size:.85rem;letter-spacing:.06em;text-transform:uppercase;font-weight:600;margin-bottom:12px;">My Path</p>
          <div class="journey-path" aria-label="Journey: Curiosity, Learning, Experimenting, Building, Sharing">
            {['Curiosity','Learning','Experimenting','Building','Sharing'].map((step, i, arr) => (
              <>
                <span class="journey-step">{step}</span>
                {i < arr.length - 1 && <span class="journey-arrow" aria-hidden="true">→</span>}
              </>
            ))}
          </div>
        </div>

        <div style="margin-top:4px;">
          <p class="muted" style="font-size:.85rem;letter-spacing:.06em;text-transform:uppercase;font-weight:600;margin-bottom:12px;">Identity</p>
          <p style="color:#c8ccd5;font-size:.95rem;line-height:1.7;">
            Cybersecurity Learner · AI Learner · Technical Writer · Content Creator · Technology Enthusiast
          </p>
        </div>
      </div>

      <div>
        <img
          src="/images/photo.png"
          alt="Abdul Qayum Akindele — professional portrait"
          style="width:100%;border-radius:18px;object-fit:cover;object-position:top;display:block;border:1px solid rgba(255,255,255,.08);"
        />
        <div class="journey-path" style="margin-top:16px;justify-content:center;" aria-label="Learning, Building, Sharing">
          <span class="journey-step">Learning</span>
          <span class="journey-arrow" aria-hidden="true">→</span>
          <span class="journey-step">Building</span>
          <span class="journey-arrow" aria-hidden="true">→</span>
          <span class="journey-step">Sharing</span>
        </div>
      </div>
    </div>
  </section>

  <!-- MY DIRECTION -->
  <section class="section" aria-labelledby="direction-heading">
    <div class="wrap">
      <span class="tag" aria-hidden="true">Journey</span>
      <h2 class="section-title" id="direction-heading" style="margin-top:12px;">My Direction</h2>
      <ul class="grid-2" role="list" style="margin-top:28px;padding:0;list-style:none;">
        {about.journeyCards.map(card => (
          <li>
            <div class="card" style="border-left:2px solid #267fff;border-radius:0 14px 14px 0;">
              <h3 style="color:#65a8ff;font-size:.85rem;text-transform:uppercase;letter-spacing:.06em;font-weight:700;">{card.label}</h3>
              <p style="margin-top:10px;color:#c8ccd5;line-height:1.7;font-size:.95rem;">{card.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- MY VALUES -->
  <section class="section" aria-labelledby="values-heading">
    <div class="wrap">
      <span class="tag" aria-hidden="true">What Guides Me</span>
      <h2 class="section-title" id="values-heading" style="margin-top:12px;">My Values</h2>
      <ul class="values-grid" role="list" style="margin-top:28px;padding:0;list-style:none;">
        {about.values.map(([icon, label]) => (
          <li>
            <div class="value-item">
              <div class="value-icon" aria-hidden="true">{icon}</div>
              <div class="value-label">{label}</div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- BEYOND TECHNOLOGY -->
  <section class="section" aria-labelledby="beyond-heading">
    <div class="wrap">
      <span class="tag" aria-hidden="true">The Bigger Picture</span>
      <h2 class="section-title" id="beyond-heading" style="margin-top:12px;">Beyond Technology</h2>
      <p style="color:#c8ccd5;max-width:600px;line-height:1.7;margin-top:12px;font-size:1rem;">
        Technology is my focus, but curiosity doesn't stop there. I'm also drawn to:
      </p>
      <ul class="focus-list" role="list" style="max-width:600px;margin-top:24px;padding:0;list-style:none;">
        {about.beyondTech.map(([icon, label]) => (
          <li class="focus-item">
            <span aria-hidden="true">{icon}</span>&nbsp;&nbsp;{label}
          </li>
        ))}
      </ul>
    </div>
  </section>

</main>
<Footer/>
</Layout>
